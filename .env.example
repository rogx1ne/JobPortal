DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

DB_NAME=career_aggregator
DB_USER=career_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# App controls
SEARCH_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=120
USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
INGESTION_MIN_DELAY_SECONDS=2
INGESTION_MAX_DELAY_SECONDS=5
INGEST_API_SCHEDULE_SECONDS=1800
INGEST_COMPANY_SCHEDULE_SECONDS=7200

# JWT settings
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Optional search engine
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=jobs

# Optional AI assistant provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional security hardening (typically enable only behind HTTPS)
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# Optional: enable Adzuna aggregation (requires free API credentials)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
